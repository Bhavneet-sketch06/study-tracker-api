# Template only - safe to commit. Contains NO real values.
#
# Copy this file to .env.local and paste your real Supabase values there.
# .env.local is listed in .gitignore, so it is never uploaded to GitHub.
#
# Find these two values in Supabase: Project Settings -> API keys.
# Use the "publishable" / "anon" key, NEVER the secret / service_role key.
#
# The code accepts either naming below, so only ONE pair is needed.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

# Alternative names, also supported:
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_ANON_KEY=your-anon-key-here
